{
  "manifest_version": 3,
  "name": "ContextForge",
  "version": "0.1.0",
  "description": "Turn any webpage into clean, token-efficient Markdown for AI tools. Local-first.",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": [
    "https://contextforge-license.example.workers.dev/*"
  ],
  "action": {
    "default_title": "ContextForge",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {}
}
